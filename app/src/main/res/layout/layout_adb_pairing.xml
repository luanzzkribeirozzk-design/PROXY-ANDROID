<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_dark"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="| COMO CONECTAR?"
        android:textColor="@color/blue_accent"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Escolha o método para informar a porta da Depuração Wi-Fi:"
        android:textColor="@color/gray_text"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_option_notification"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/blue_primary"
        android:text="Via Notificação"
        android:textColor="@color/white"
        app:cornerRadius="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Envia uma notificação onde você digita a porta"
        android:textColor="@color/gray_text"
        android:textSize="11sp" />

    <Button
        android:id="@+id/btn_option_splitscreen"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/card_dark"
        android:text="Via Dividir Tela"
        android:textColor="@color/white"
        app:cornerRadius="12dp"
        app:strokeColor="@color/blue_accent"
        app:strokeWidth="1dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Abre split-screen e você digita a porta no campo abaixo"
        android:textColor="@color/gray_text"
        android:textSize="11sp" />

    <Button
        android:id="@+id/btn_pair_notification"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@android:color/transparent"
        android:text="Cancelar"
        android:textColor="@color/gray_text" />

</LinearLayout>
