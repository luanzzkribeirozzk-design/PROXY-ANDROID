<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_dark"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="| DEPURAÇÃO WI-FI"
            android:textColor="@color/blue_accent"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Parear o celular consigo mesmo via ADB"
            android:textColor="@color/gray_text"
            android:textSize="12sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="12dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_adb_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:text="Aguardando..."
                    android:textColor="@color/blue_accent"
                    app:drawableStartCompat="@drawable/ic_dot_offline" />

                <TextView
                    android:id="@+id/tv_local_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:textColor="@color/gray_text" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="COMO PAREAR"
            android:textColor="@color/blue_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1. Configurações → Opções do desenvolvedor\n2. Ative 'Depuração Wi-Fi'\n3. Toque em 'Parear dispositivo com código'\n4. Anote o código de 6 dígitos e a PORTA mostrada\n5. Digite abaixo e toque em PAREAR"
            android:textColor="@color/gray_text"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="CÓDIGO DE PAREAMENTO"
            android:textColor="@color/gray_text"
            android:textSize="10sp" />

        <EditText
            android:id="@+id/et_pairing_code"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext"
            android:gravity="center"
            android:hint="Ex: 123456"
            android:inputType="number"
            android:maxLength="6"
            android:textColor="@color/white"
            android:textColorHint="@color/gray_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="PORTA (mostrada na tela de pareamento)"
            android:textColor="@color/gray_text"
            android:textSize="10sp" />

        <EditText
            android:id="@+id/et_port"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext"
            android:gravity="center"
            android:hint="Ex: 37681"
            android:inputType="number"
            android:textColor="@color/white"
            android:textColorHint="@color/gray_text" />

        <Button
            android:id="@+id/btn_pair_submit"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/blue_primary"
            android:text="PAREAR E INJETAR"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btn_pair_notification"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/card_dark"
            android:text="FECHAR"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:strokeColor="@color/blue_accent"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>
